{
  "name": "rukie-hosted-app-testing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "format": "oxfmt --write backend frontend shared tests devtools",
    "lint": "oxlint backend frontend shared",
    "format:check": "oxfmt --check backend frontend shared tests devtools",
    "start": "bun backend/main.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "oxfmt": "0.40.0",
    "oxlint": "1.50.0"
  }
}
