{
  "version": 2,
  "dockerfile": "Dockerfile",
  "endpoints": [
    {
      "name": "web",
      "port": 8080,
      "health_path": "/health/ready"
    },
    {
      "name": "viewer",
      "port": 8082,
      "health_path": "/health/ready",
      "auth": "rukie"
    }
  ],
  "databases": [
    "main"
  ],
  "blob_storage": true,
  "rukie_api": {
    "port": 8081,
    "path": "/rukie"
  },
  "connections": {
    "rooms": {
      "reports": {
        "description": "Where this app sends note reports."
      }
    },
    "users": {
      "reviewer": {
        "description": "The person asked to review note reports.",
        "human_only": true
      }
    }
  }
}
